# Skopiuj do .env i uzupełnij. .env NIE trafia do repo.
# Wygeneruj: python -c "import secrets;print(secrets.token_hex(32))"
# Aplikacja odmówi startu z wartością 'zmien-mnie'.
SECRET_KEY=zmien-mnie
DATABASE_URL=mysql+pymysql://xmlparser:xmlparser@db:3306/xmlparser?charset=utf8mb4
MARIADB_ROOT_PASSWORD=zmien-mnie-root
MARIADB_DATABASE=xmlparser
MARIADB_USER=xmlparser
MARIADB_PASSWORD=xmlparser
STORAGE_DIR=/data/storage
MAX_DOCUMENT_BYTES=10485760
# limity przeciw DoS: maks. liczba węzłów drzewa pliku i maks. liczba pozycji faktury
MAX_TREE_NODES=200000
MAX_LINES=5000
ADMIN_EMAIL=admin@example.com
# Wymagane własne hasło min. 10 znaków (przykładowe/krótkie => konto admin NIE powstanie)
ADMIN_PASSWORD=zmien-mnie
# Tryb demo (publiczna strona „O demo”, kartoteka i klucz demo). Domyślnie wyłączony.
DEMO_MODE=0
# Klucz API demo pokazywany zalogowanym na stronie „O demo” (tylko w DEMO_MODE). Wartość przykładowa z repozytorium
# i klucze krótsze niż 24 znaki są odrzucane (ostrzeżenie przy seedzie, klucz nie powstaje). Wygeneruj:
# python -c "import secrets;print('xp_'+secrets.token_urlsafe(24))"
DEMO_API_KEY=
# Strefa czasowa wyświetlania w panelu (nazwa IANA); baza i API zostają w UTC. Domyślnie Europe/Warsaw.
# DISPLAY_TZ=Europe/Warsaw
# Domyślnie tylko localhost. Dla dostępu przez Tailscale wpisz IP interfejsu tailscale0 (tailscale ip -4).
APP_BIND=127.0.0.1
APP_PORT=18506
# Podsieć domyślnej sieci Docker Compose (gdy pule adresów hosta są wyczerpane); na nowym hoście dobierz wolną
XP_SUBNET=10.210.10.0/24
# Port wewnętrzny kontenera (gunicorn); PORT platformy ma pierwszeństwo. Jedno źródło dla compose, obrazu i sondy.
# APP_INTERNAL_PORT=5010
# Migracje i seed przy starcie kontenera pod blokadą bazy (1). 0 = platforma uruchamia je osobnym zadaniem
# (init container / job: flask db upgrade && flask seed). MIGRATE_LOCK_TIMEOUT = ile sekund replika czeka na blokadę.
# MIGRATE_ON_START=1
# MIGRATE_LOCK_TIMEOUT=600
# Liczba prób połączenia z bazą przy starcie (odstęp 2 → 30 s)
# DB_WAIT_ATTEMPTS=10
# Pojedyncze flagi gunicorna (liczba procesów, wątków na proces, timeout żądania w sekundach) i katalog plików
# heartbeat workerów (dodawany tylko, gdy istnieje — runtime bez /dev/shm)
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=8
# GUNICORN_TIMEOUT=60
# GUNICORN_WORKER_TMP_DIR=/dev/shm
# Cały zestaw flag gunicorna — zastępuje wszystkie powyższe i domyślne z docker/entrypoint.sh
# GUNICORN_CMD_ARGS=-k gthread -w 2 --threads 8 --timeout 60 --graceful-timeout 30 --max-requests 1000 --max-requests-jitter 100 --worker-tmp-dir /dev/shm
# Kopie zapasowe (tools/backup.sh): katalog docelowy (np. osobny dysk) i retencja w dniach
# BACKUP_DIR=backups
# BACKUP_RETENTION_DAYS=14
# Limity zasobów kontenerów (opcjonalne)
# APP_MEM_LIMIT=1g
# APP_CPUS=2.0
# DB_MEM_LIMIT=1g
# DB_CPUS=1.0
# Ciasteczka sesji tylko po HTTPS — włącz (1), gdy panel jest za TLS. Przy HTTP przez Tailscale zostaw 0.
# 1 przy tailscale serve / reverse proxy z TLS (README: „HTTPS w tailnecie”); przy TRUSTED_PROXY_COUNT>0 i 0 aplikacja
# ostrzega w logu przy starcie
SESSION_COOKIE_SECURE=0
# Liczba zaufanych reverse proxy przed aplikacją (0 = ignoruj X-Forwarded-*). Za proxy MUSI być liczbą proxy —
# inaczej wszystkie żądania mają adres proxy i limit logowań per IP działa jak globalny (aplikacja ostrzega w logu)
# 1 przy tailscale serve / reverse proxy z TLS
TRUSTED_PROXY_COUNT=0
# Schemat adresów zewnętrznych budowanych poza żądaniem (CLI); https za proxy z TLS
# PREFERRED_URL_SCHEME=http
# Czas życia sesji panelu w godzinach (demo publiczne: krócej, np. 1)
# SESSION_HOURS=8
# Retencja dziennika: `flask prune-audit` (np. z crona) usuwa wpisy login_failed/login_blocked starsze niż tyle dni
# AUDIT_RETENTION_DAYS=90
# Limit nieudanych logowań: per (e-mail, IP), per IP, per sam e-mail (wyższy próg, krótsze okno); minuty
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_MAX_ATTEMPTS_PER_EMAIL=50
LOGIN_EMAIL_LOCKOUT_MINUTES=5
# Webhooki (v0.9.0) — powiadomienia o zmianie statusu dokumentu na adres ustawiony przy kluczu API.
# Publiczny adres panelu do pola document_url w ładunku (np. https://xp.example.com); pusty = adres z żądania,
# a w workerze (poza żądaniem) document_url = null
# PUBLIC_BASE_URL=
# Adresy webhooków tylko https; 1 dopuszcza http (sieć wewnętrzna, testy)
# WEBHOOK_ALLOW_HTTP=0
# Adresy niepubliczne (prywatne, loopback, link-local, CGNAT) są blokowane (SSRF). Wyjątki: nazwy hostów i podsieci
# CIDR po przecinku, np. erp.local,10.20.0.0/16
# WEBHOOK_ALLOWED_HOSTS=
# Retencja: `flask prune-webhooks` (np. z crona) usuwa zakończone dostawy starsze niż tyle dni
# WEBHOOK_RETENTION_DAYS=30
# Plik heartbeat workera webhooków (healthcheck usługi worker); pusty = bez heartbeatu
# WEBHOOK_HEARTBEAT_FILE=
